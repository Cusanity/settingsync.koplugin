#: _meta.lua
msgid "SettingSync"
msgstr "设置同步"

#: _meta.lua
msgid "Synchronize KOReader settings across devices via WebDAV with per-key diff and selective sync."
msgstr "通过 WebDAV 跨设备同步 KOReader 设置，支持逐项对比和选择性同步。"

#: main.lua - source descriptions
msgid "Global KOReader settings"
msgstr "全局 KOReader 设置"

msgid "Plugin settings: %s"
msgstr "插件设置：%s"

msgid "Plugin config: %s"
msgstr "插件配置：%s"

#: main.lua - main menu
msgid "Sync now"
msgstr "立即同步"

msgid "Compares this device with the cloud and merges the differences automatically. If the same setting was changed in both places, you decide which version to keep."
msgstr "将本设备与云端进行比较并自动合并差异。如果同一项设置在两处都被修改，则由你决定保留哪个版本。"

msgid "Cloud account: "
msgstr "云账户："

msgid "Set up cloud account…"
msgstr "设置云账户…"

msgid "This device: "
msgstr "本设备："

msgid "What to sync"
msgstr "同步内容"

msgid "Advanced"
msgstr "高级"

msgid "Not set up yet"
msgstr "尚未设置"

msgid "Not synced yet"
msgstr "尚未同步"

msgid "Last synced: "
msgstr "上次同步："

#: main.lua - what to sync
msgid "KOReader settings"
msgstr "KOReader 设置"

msgid "Reading, display and behaviour settings (settings.reader.lua)."
msgstr "阅读、显示和行为设置 (settings.reader.lua)。"

msgid "Plugin settings"
msgstr "插件设置"

msgid "Settings saved by other installed plugins."
msgstr "其他已安装插件保存的设置。"

msgid "Plugin configuration files"
msgstr "插件配置文件"

msgid "configuration.lua files bundled with plugins."
msgstr "插件附带的 configuration.lua 文件。"

#: main.lua - advanced
msgid "Review and choose each change…"
msgstr "逐项查看并选择…"

msgid "See every differing setting and pick push or pull per item."
msgstr "查看每一项差异设置，并逐项选择推送或拉取。"

msgid "Restore from another device"
msgstr "从其他设备恢复"

msgid "Copy a group of settings from another device's backup."
msgstr "从其他设备的备份复制一组设置。"

msgid "Force upload — overwrite cloud"
msgstr "强制上传 — 覆盖云端"

msgid "Force download — overwrite this device"
msgstr "强制下载 — 覆盖本设备"

msgid "Nothing available to restore"
msgstr "没有可恢复的内容"

#: main.lua - cloud config dialog
msgid "Cloud service:\n%1\n\nSync folder:\n%2"
msgstr "云服务：\n%1\n\n同步目录：\n%2"

msgid "Delete"
msgstr "删除"

msgid "Remove cloud service configuration?"
msgstr "确定移除云服务配置？"

msgid "Remove"
msgstr "移除"

msgid "Change"
msgstr "更改"

msgid "Close"
msgstr "关闭"

msgid "Cloud service configured."
msgstr "云服务配置完成。"

#: main.lua - diff & sync workflow
msgid "No settings sources enabled. Check Sync scope settings."
msgstr "未启用任何设置源。请检查同步范围设置。"

msgid "Downloading settings from cloud…"
msgstr "正在从云端下载设置…"

msgid "All settings are in sync!"
msgstr "所有设置已同步！"

msgid " changes"
msgstr " 项变更"

msgid "Sync complete."
msgstr "同步完成。"

msgid "Failed to upload %s to cloud."
msgstr "上传 %s 到云端失败。"

#: main.lua - quick sync
msgid "Upload all local settings to cloud? This will overwrite cloud copies."
msgstr "将所有本地设置上传到云端？这将覆盖云端副本。"

msgid "Download all settings from cloud? This will overwrite local copies."
msgstr "从云端下载所有设置？这将覆盖本地副本。"

msgid "Push"
msgstr "推送"

msgid "Pull"
msgstr "拉取"

msgid "Synced %d settings file(s) successfully."
msgstr "已成功同步 %d 个设置文件。"

#: main.lua - sync now
msgid "Nothing is selected to sync. Open \"What to sync\" to choose."
msgstr "未选择任何要同步的内容。请打开“同步内容”进行选择。"

msgid "Syncing…"
msgstr "正在同步…"

msgid "Everything is already up to date."
msgstr "所有内容均已是最新。"

msgid "Sync complete: %d uploaded, %d downloaded."
msgstr "同步完成：上传 %d 项，下载 %d 项。"

msgid "%d setting(s) were changed on both this device and the cloud.\n\nWhich version should be kept?"
msgstr "有 %d 项设置在本设备和云端都被修改。\n\n应保留哪个版本？"

msgid "Keep this device"
msgstr "保留本设备"

msgid "Keep cloud"
msgstr "保留云端"

msgid "Choose for each…"
msgstr "逐项选择…"

msgid "Synced %d file(s), %d failed."
msgstr "已同步 %d 个文件，%d 个失败。"

#: settingsync_ui.lua - diff viewer
msgid "No differences found between local and cloud settings."
msgstr "本地与云端设置无差异。"

msgid "Settings Diff"
msgstr "设置对比"

msgid "%d changed: %d ≠ modified, %d ↑ local only, %d ↓ cloud only"
msgstr "%d 项变更：%d 项修改，%d 项仅本地，%d 项仅云端"

msgid "Tap a row to select: ⬇ Pull = take cloud value · ⬆ Push = send local value"
msgstr "点击行选择：⬇ 拉取 = 取云端值 · ⬆ 推送 = 发送本地值"

msgid "⬇ Pull from cloud"
msgstr "⬇ 从云端拉取"

msgid "⬆ Push to cloud"
msgstr "⬆ 推送到云端"

msgid "  ─ tap to select"
msgstr "  ─ 点击选择"

msgid "Pull all"
msgstr "全部拉取"

msgid "Push all"
msgstr "全部推送"

msgid "Clear"
msgstr "清除"

msgid "Cancel"
msgstr "取消"

msgid "Apply"
msgstr "应用"

msgid "No keys selected. Tap rows to select push/pull actions."
msgstr "未选择任何项。点击行以选择推送/拉取操作。"

msgid "Local:"
msgstr "本地："

msgid "Cloud:"
msgstr "云端："

#: settingsync_categories.lua - category definitions
msgid "Gestures"
msgstr "手势"

msgid "Touch gesture action mappings"
msgstr "触摸手势动作映射"

msgid "Cloud storage & WebDAV"
msgstr "云存储与 WebDAV"

msgid "Cloud servers, WebDAV list and default upload/download folders."
msgstr "云服务器、WebDAV 列表以及默认的上传/下载目录。"

msgid "Highlight export"
msgstr "导出高亮"

msgid "Export formats and destinations."
msgstr "导出格式与目标位置。"

msgid "Reading statistics"
msgstr "阅读统计"

msgid "Reading statistics options (not the history database)."
msgstr "阅读统计选项（不含历史数据库）。"

msgid "Progress sync"
msgstr "进度同步"

msgid "Progress sync server, account and options."
msgstr "进度同步服务器、账户与选项。"

msgid "X-Ray"
msgstr "X-Ray"

msgid "All X-Ray options and its sync server settings."
msgstr "全部 X-Ray 选项及其同步服务器设置。"

msgid "Highlight sync"
msgstr "高亮同步"

msgid "Highlight sync server and options."
msgstr "高亮同步服务器与选项。"

msgid "AI assistant"
msgstr "AI 助手"

msgid "AI assistant preferences, provider and model selection."
msgstr "AI 助手偏好设置、服务商与模型选择。"

msgid "File manager gesture map"
msgstr "文件管理器手势映射"

msgid "Reader gesture map"
msgstr "阅读器手势映射"

msgid "Custom multiswipe gestures"
msgstr "自定义多重滑动手势"

msgid "%d gestures defined"
msgstr "已定义 %d 个手势"

msgid "%d custom multiswipes"
msgstr "%d 个自定义多重滑动"

msgid "(none)"
msgstr "（无）"

#: main.lua - device and category sync
msgid "Device name"
msgstr "设备名称"

msgid "Save"
msgstr "保存"

msgid "e.g. Kindle PW5"
msgstr "例如：Kindle PW5"

msgid "Device name saved."
msgstr "设备名称已保存。"

msgid "Sync: %s"
msgstr "同步：%s"

msgid "My backup (%s)"
msgstr "我的备份 (%s)"

msgid "Select source device"
msgstr "选择来源设备"
