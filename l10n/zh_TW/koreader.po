#: _meta.lua
msgid "SettingSync"
msgstr "設定同步"

#: _meta.lua
msgid "Synchronize KOReader settings across devices via WebDAV with per-key diff and selective sync."
msgstr "透過 WebDAV 跨裝置同步 KOReader 設定，支援逐項比對和選擇性同步。"

#: main.lua - main menu
msgid "Sync now"
msgstr "立即同步"

msgid "Compares this device with the cloud and merges the differences automatically. If the same setting was changed in both places, you decide which version to keep."
msgstr "將本裝置與雲端進行比較並自動合併差異。如果同一項設定在兩處都被修改，則由你決定保留哪個版本。"

msgid "Cloud account: "
msgstr "雲端帳戶："

msgid "Set up cloud account…"
msgstr "設定雲端帳戶…"

msgid "This device: "
msgstr "本裝置："

msgid "What to sync"
msgstr "同步內容"

msgid "Advanced"
msgstr "進階"

msgid "Not set up yet"
msgstr "尚未設定"

msgid "Not synced yet"
msgstr "尚未同步"

msgid "Last synced: "
msgstr "上次同步："

#: main.lua - advanced
msgid "Review and choose each change…"
msgstr "逐項檢視並選擇…"

msgid "See every differing setting and pick push or pull per item."
msgstr "檢視每一項差異設定，並逐項選擇推送或拉取。"

msgid "Restore from another device"
msgstr "從其他裝置還原"

msgid "Copy a group of settings from another device's backup."
msgstr "從其他裝置的備份複製一組設定。"

msgid "Force upload — overwrite cloud"
msgstr "強制上傳 — 覆蓋雲端"

msgid "Force download — overwrite this device"
msgstr "強制下載 — 覆蓋本裝置"

msgid "Nothing available to restore"
msgstr "沒有可還原的內容"

#: main.lua - cloud config dialog
msgid "Cloud service:\n%1\n\nSync folder:\n%2"
msgstr "雲端服務：\n%1\n\n同步目錄：\n%2"

msgid "Delete"
msgstr "刪除"

msgid "Remove cloud service configuration?"
msgstr "確定移除雲端服務設定？"

msgid "Remove"
msgstr "移除"

msgid "Change"
msgstr "變更"

msgid "Close"
msgstr "關閉"

msgid "Cloud service configured."
msgstr "雲端服務設定完成。"

msgid "Downloading settings from cloud…"
msgstr "正在從雲端下載設定…"

msgid "All settings are in sync!"
msgstr "所有設定已同步！"

msgid " changes"
msgstr " 項變更"

msgid "Sync complete."
msgstr "同步完成。"

msgid "Sync complete. %d group(s) skipped."
msgstr "同步完成。已跳過 %d 組。"

msgid "Sync stopped. %d group(s) left unchanged."
msgstr "同步已停止。%d 組未變更。"

msgid "Failed to upload %s to cloud."
msgstr "上傳 %s 至雲端失敗。"

#: main.lua - quick sync
msgid "Upload all local settings to cloud? This will overwrite cloud copies."
msgstr "將所有本機設定上傳至雲端？這將覆蓋雲端副本。"

msgid "Download all settings from cloud? This will overwrite local copies."
msgstr "從雲端下載所有設定？這將覆蓋本機副本。"

msgid "Push"
msgstr "推送"

msgid "Pull"
msgstr "拉取"

msgid "Synced %d settings file(s) successfully."
msgstr "已成功同步 %d 個設定檔案。"

#: main.lua - sync now
msgid "Nothing is selected to sync. Open \"What to sync\" to choose."
msgstr "未選擇任何要同步的內容。請開啟「同步內容」進行選擇。"

msgid "Syncing…"
msgstr "正在同步…"

msgid "Everything is already up to date."
msgstr "所有內容均已是最新。"

msgid "Sync complete: %d uploaded, %d downloaded."
msgstr "同步完成：上傳 %d 項，下載 %d 項。"

msgid "%d setting(s) were changed on both this device and the cloud.\n\nWhich version should be kept?"
msgstr "有 %d 項設定在本裝置和雲端都被修改。\n\n應保留哪個版本？"

msgid "Keep this device"
msgstr "保留本裝置"

msgid "Keep cloud"
msgstr "保留雲端"

msgid "Choose for each…"
msgstr "逐項選擇…"

msgid "Skip them"
msgstr "跳過這些項目"

msgid "Synced %d file(s), %d failed."
msgstr "已同步 %d 個檔案，%d 個失敗。"

#: settingsync_ui.lua - diff viewer
msgid "No differences found between local and cloud settings."
msgstr "本機與雲端設定無差異。"

msgid "Settings Diff"
msgstr "設定比對"

msgid "%d changed: %d ≠ modified, %d ↑ local only, %d ↓ cloud only"
msgstr "%d 項變更：%d 項修改，%d 項僅本機，%d 項僅雲端"

msgid "Tap a row to select: ⬇ Pull = take cloud value · ⬆ Push = send local value"
msgstr "點擊列選擇：⬇ 拉取 = 取雲端值 · ⬆ 推送 = 傳送本機值"

msgid "Tap a row to select: ⬇ Pull = take cloud file · ⬆ Push = send local file. Hold a row for the full diff."
msgstr "點擊列選擇：⬇ 拉取 = 取雲端檔案 · ⬆ 推送 = 傳送本機檔案。長按可檢視完整差異。"

msgid "%d lines only local (−) · %d lines only in cloud (+)"
msgstr "%d 行僅本機（−）· %d 行僅雲端（+）"

msgid "… %d more diff lines, hold to see the whole diff"
msgstr "…尚有 %d 行差異，長按檢視完整差異"

msgid "Diff: %s"
msgstr "差異：%s"

msgid "⬇ Pull from cloud"
msgstr "⬇ 從雲端拉取"

msgid "⬆ Push to cloud"
msgstr "⬆ 推送至雲端"

msgid "  ─ tap to select"
msgstr "  ─ 點擊選擇"

msgid "Pull all"
msgstr "全部拉取"

msgid "Push all"
msgstr "全部推送"

msgid "Clear"
msgstr "清除"

msgid "Skip"
msgstr "跳過"

msgid "Cancel"
msgstr "取消"

msgid "Apply"
msgstr "套用"

msgid "No keys selected. Tap rows to select push/pull actions."
msgstr "未選擇任何項目。點擊列以選擇推送/拉取操作。"

msgid "Local:"
msgstr "本機："

msgid "Cloud:"
msgstr "雲端："

#: settingsync_categories.lua - category definitions
msgid "Gestures"
msgstr "手勢"

msgid "Touch gesture action mappings"
msgstr "觸控手勢動作對映"

msgid "Cloud storage & WebDAV"
msgstr "雲端儲存與 WebDAV"

msgid "Cloud servers and the WebDAV list. The local upload/download folders stay per-device."
msgstr "雲端伺服器與 WebDAV 清單。本機的上傳/下載資料夾仍依裝置各自保留。"

msgid "Highlight export"
msgstr "匯出標註"

msgid "Export formats and destinations."
msgstr "匯出格式與目標位置。"

msgid "Reading statistics"
msgstr "閱讀統計"

msgid "Reading statistics options (not the history database)."
msgstr "閱讀統計選項（不含歷史資料庫）。"

msgid "Progress sync"
msgstr "進度同步"

msgid "Progress sync server, account and options."
msgstr "進度同步伺服器、帳戶與選項。"

msgid "X-Ray"
msgstr "X-Ray"

msgid "All X-Ray options and its sync server settings."
msgstr "全部 X-Ray 選項及其同步伺服器設定。"

msgid "Highlight sync"
msgstr "標註同步"

msgid "Highlight sync server and options."
msgstr "標註同步伺服器與選項。"

msgid "AI assistant"
msgstr "AI 助手"

msgid "AI assistant preferences, provider and model selection."
msgstr "AI 助手偏好設定、服務商與模型選擇。"

msgid "File manager gesture map"
msgstr "檔案管理器手勢對映"

msgid "Reader gesture map"
msgstr "閱讀器手勢對映"

msgid "Custom multiswipe gestures"
msgstr "自訂多重滑動手勢"

msgid "%d gestures defined"
msgstr "已定義 %d 個手勢"

msgid "%d custom multiswipes"
msgstr "%d 個自訂多重滑動"

msgid "(none)"
msgstr "（無）"

#: main.lua - device and category sync
msgid "Device name"
msgstr "裝置名稱"

msgid "Save"
msgstr "儲存"

msgid "e.g. Kindle PW5"
msgstr "例如：Kindle PW5"

msgid "Device name saved."
msgstr "裝置名稱已儲存。"

msgid "Devices in cloud…"
msgstr "雲端裝置…"

msgid "Every device profile in the cloud folder and what each one has uploaded."
msgstr "雲端資料夾中的所有裝置設定檔，以及各自已上傳的內容。"

msgid "Reading device list from cloud…"
msgstr "正在從雲端讀取裝置清單…"

msgid "No device backups found in the cloud yet. Sync once to create one."
msgstr "雲端尚無任何裝置備份。先同步一次即可建立。"

msgid "Devices in cloud"
msgstr "雲端裝置"

msgid "%s (this device)"
msgstr "%s（本裝置）"

msgid "%d groups"
msgstr "%d 組"

msgid "nothing uploaded"
msgstr "尚未上傳"

msgid "This device has not uploaded anything yet."
msgstr "該裝置尚未上傳任何內容。"

msgid "Sync: %s"
msgstr "同步：%s"

msgid "My backup (%s)"
msgstr "我的備份 (%s)"

msgid "Select source device"
msgstr "選擇來源裝置"

msgid "Status bar"
msgstr "狀態列"

msgid "Status bar layout, enabled items and saved presets."
msgstr "狀態列佈局、啟用項目及已儲存的預設。"

msgid "Status bar settings"
msgstr "狀態列設定"

msgid "Active mode"
msgstr "目前模式"

msgid "Custom text"
msgstr "自訂文字"

msgid "Custom text repetitions"
msgstr "自訂文字重複次數"

msgid "Saved presets"
msgstr "已儲存的預設"

msgid "Select all"
msgstr "全選"

msgid "Deselect all"
msgstr "全不選"

msgid "Screen"
msgstr "螢幕"

msgid "Screen and display settings."
msgstr "螢幕與顯示設定。"

msgid "Network"
msgstr "網路"

msgid "Network and Wi-Fi settings."
msgstr "網路與Wi-Fi設定。"

msgid "Navigation"
msgstr "導航"

msgid "Navigation, button and gesture settings."
msgstr "導航、按鍵與手勢設定。"

msgid "Document"
msgstr "文件"

msgid "Document handling and metadata settings."
msgstr "文件處理與中繼資料設定。"

msgid "Language"
msgstr "語言"

msgid "Language, units and time format."
msgstr "語言、單位與時間格式。"

msgid "Device"
msgstr "裝置"

msgid "Device-specific hardware settings."
msgstr "裝置專屬硬體設定。"

msgid "No categories enabled. Open \"What to sync\" to choose."
msgstr "未啟用任何類別。請開啟\u300c同步內容\u300d進行選擇。"

msgid "Other reader settings"
msgstr "其他閱讀器設定"

msgid "Everything in settings.reader.lua that no other category covers. New KOReader settings land here automatically."
msgstr "settings.reader.lua 中未被其他類別涵蓋的所有設定。KOReader 新增的設定會自動歸入此處。"

msgid "%s settings"
msgstr "%s 設定"

msgid "Custom defaults"
msgstr "自訂預設值"

msgid "Advanced settings that override KOReader's built-in defaults. New overrides are picked up automatically."
msgstr "覆寫 KOReader 內建預設值的進階設定。新增的覆寫項目會自動納入同步。"

msgid "%s configuration file"
msgstr "%s 設定檔"

msgid "Whole-file backup of this plugin's hand-edited configuration file, which is where its API keys live. Pulling it replaces the local file with Lua the plugin will execute."
msgstr "對該插件手動編輯的設定檔進行整檔案備份，其 API 金鑰即儲存於此。拉取會用插件將要執行的 Lua 替換本機檔案。"

msgid "File contents"
msgstr "檔案內容"

msgid "The Cloud storage plugin is required for syncing but isn't available."
msgstr "同步需要雲端儲存外掛，但該外掛無法使用。"

msgid "Saved Wi-Fi networks"
msgstr "已儲存的 Wi-Fi 網路"

msgid "Access points remembered by KOReader, with their passwords, so another device joins the same networks."
msgstr "KOReader 記住的無線存取點，連同密碼一起同步，讓另一台裝置也能連上相同網路。"

msgid "Saved passwords"
msgstr "已儲存的密碼"

msgid "Logins kept in settings.reader.lua, such as the Calibre password and OPDS server accounts."
msgstr "settings.reader.lua 中儲存的登入資訊，例如 Calibre 密碼和 OPDS 伺服器帳號。"

msgid "Style tweaks"
msgstr "樣式微調"

msgid "Your own CSS files from styletweaks/. The setting that switches them on syncs with the reader settings, so both sides stay in step."
msgstr "來自 styletweaks/ 的自訂 CSS 檔案。啟用它們的設定項會隨閱讀器設定一同同步，兩邊始終保持一致。"

msgid "User patches"
msgstr "使用者修補程式"

msgid "Lua files from patches/, which KOReader runs at startup. Off by default: pulling one means executing code from your cloud on this device."
msgstr "來自 patches/ 的 Lua 檔案，KOReader 會在啟動時執行。預設關閉：拉取意味著在本裝置上執行來自雲端的程式碼。"

msgid "All settings stored in settings/%s by an installed plugin, including any accounts or tokens it keeps there."
msgstr "已安裝插件儲存在 settings/%s 中的全部設定，包括其中儲存的帳號或權杖。"

msgid "Could not read the local file for %s. Skipping it."
msgstr "無法讀取 %s 的本機檔案，已略過。"

msgid "Could not read the local file for %s. Nothing was changed."
msgstr "無法讀取 %s 的本機檔案，未做任何變更。"

msgid "Some downloaded settings live in files KOReader already has open. Restart to apply them — otherwise they will be overwritten when you exit."
msgstr "部分下載的設定位於 KOReader 已開啟的檔案中。請重新啟動以套用——否則結束時它們會被覆寫。"
