#: _meta.lua
msgid "SettingSync"
msgstr "設定同步"

#: _meta.lua
msgid "Synchronize KOReader settings across devices via WebDAV with per-key diff and selective sync."
msgstr "透過 WebDAV 跨裝置同步 KOReader 設定，支援逐項比對和選擇性同步。"

#: main.lua - source descriptions
msgid "Global KOReader settings"
msgstr "全域 KOReader 設定"

msgid "Plugin settings: %s"
msgstr "外掛設定：%s"

msgid "Plugin config: %s"
msgstr "外掛組態：%s"

#: main.lua - main menu
msgid "Cloud: "
msgstr "雲端："

msgid "Configure cloud service…"
msgstr "設定雲端服務…"

msgid "Compare & sync all settings…"
msgstr "比對並同步全部設定…"

msgid "Push all to cloud"
msgstr "推送全部至雲端"

msgid "Pull all from cloud"
msgstr "從雲端拉取全部"

msgid "Sync scope"
msgstr "同步範圍"

msgid "Global settings (settings.reader.lua)"
msgstr "全域設定 (settings.reader.lua)"

msgid "Plugin settings (settings/*.lua)"
msgstr "外掛設定 (settings/*.lua)"

msgid "Plugin configs (configuration.lua)"
msgstr "外掛組態 (configuration.lua)"

#: main.lua - cloud config dialog
msgid "Cloud service:\n%1\n\nSync folder:\n%2"
msgstr "雲端服務：\n%1\n\n同步目錄：\n%2"

msgid "Delete"
msgstr "刪除"

msgid "Remove cloud service configuration?"
msgstr "確定移除雲端服務設定？"

msgid "Remove"
msgstr "移除"

msgid "Change"
msgstr "變更"

msgid "Close"
msgstr "關閉"

msgid "Cloud service configured."
msgstr "雲端服務設定完成。"

#: main.lua - diff & sync workflow
msgid "No settings sources enabled. Check Sync scope settings."
msgstr "未啟用任何設定來源。請檢查同步範圍設定。"

msgid "Downloading settings from cloud…"
msgstr "正在從雲端下載設定…"

msgid "All settings are in sync!"
msgstr "所有設定已同步！"

msgid " changes"
msgstr " 項變更"

msgid "Sync complete."
msgstr "同步完成。"

msgid "Failed to upload %s to cloud."
msgstr "上傳 %s 至雲端失敗。"

#: main.lua - quick sync
msgid "Upload all local settings to cloud? This will overwrite cloud copies."
msgstr "將所有本機設定上傳至雲端？這將覆蓋雲端副本。"

msgid "Download all settings from cloud? This will overwrite local copies."
msgstr "從雲端下載所有設定？這將覆蓋本機副本。"

msgid "Push"
msgstr "推送"

msgid "Pull"
msgstr "拉取"

msgid "Synced %d settings file(s) successfully."
msgstr "已成功同步 %d 個設定檔案。"

msgid "Synced %d file(s), %d failed."
msgstr "已同步 %d 個檔案，%d 個失敗。"

#: settingsync_ui.lua - diff viewer
msgid "No differences found between local and cloud settings."
msgstr "本機與雲端設定無差異。"

msgid "Settings Diff"
msgstr "設定比對"

msgid "%d changed: %d ≠ modified, %d ↑ local only, %d ↓ cloud only"
msgstr "%d 項變更：%d 項修改，%d 項僅本機，%d 項僅雲端"

msgid "Tap a row to select: ⬇ Pull = take cloud value · ⬆ Push = send local value"
msgstr "點擊列選擇：⬇ 拉取 = 取雲端值 · ⬆ 推送 = 傳送本機值"

msgid "⬇ Pull from cloud"
msgstr "⬇ 從雲端拉取"

msgid "⬆ Push to cloud"
msgstr "⬆ 推送至雲端"

msgid "  ─ tap to select"
msgstr "  ─ 點擊選擇"

msgid "Pull all"
msgstr "全部拉取"

msgid "Push all"
msgstr "全部推送"

msgid "Clear"
msgstr "清除"

msgid "Cancel"
msgstr "取消"

msgid "Apply"
msgstr "套用"

msgid "No keys selected. Tap rows to select push/pull actions."
msgstr "未選擇任何項目。點擊列以選擇推送/拉取操作。"

msgid "Local:"
msgstr "本機："

msgid "Cloud:"
msgstr "雲端："

