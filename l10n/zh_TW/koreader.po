msgstr "全不選"

msgid "KOReader core settings"
msgstr "KOReader 核心設定"

msgid "Screen"
msgstr "螢幕"

msgid "Screen and display settings."
msgstr "螢幕與顯示設定。"

msgid "Network"
msgstr "網路"

msgid "Network and Wi-Fi settings."
msgstr "網路與Wi-Fi設定。"

msgid "Navigation"
